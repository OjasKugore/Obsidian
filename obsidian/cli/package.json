{
  "name": "obsidian-cli",
  "version": "1.0.0",
  "description": "Developer CLI for Obsidian encrypted pastebin — send, receive, and manage E2EE pastes from the terminal",
  "type": "module",
  "bin": {
    "obsidian": "bin/obsidian.js"
  },
  "scripts": {
    "dev": "node --import tsx/esm src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "base-x": "^4.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.0",
    "tar": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/tar": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
