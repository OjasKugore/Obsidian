// prisma/schema.prisma
// ─────────────────────────────────────────────────────────────────────────────
// Database Schema Definition for Obsidian Encrypted Pastebin.
//
// Defines PostgreSQL database models (Paste, Comment, AccessLog, ServerConfig)
// for storing encrypted zero-knowledge payloads, expiration timers, and audit logs.
// ─────────────────────────────────────────────────────────────────────────────

// ── PRISMA GENERATOR & DATASOURCE CONFIG ─────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── DATABASE MODELS ───────────────────────────────────────────────────

// ── 1. Paste Model (Core Encrypted Paste Vault Storage) ───────────────

model Paste {
  /// fnv1a64(ciphertext) — 16 lowercase hex chars
  id               String    @id

  /// AES-256-GCM ciphertext, base64-encoded
  ciphertext       String    @db.Text

  /// Full adata JSON array (v2 wire format)
  adata            Json

  createdAt        DateTime  @default(now())
  expiresAt        DateTime?

  /// Server deletes atomically on first GET (SELECT FOR UPDATE → DELETE → RETURN)
  burnAfterReading Boolean   @default(false)

  openDiscussion   Boolean   @default(false)

  /// Per-paste random salt used to derive the deleteToken
  salt             String

  /// Number of times this paste has been viewed
  views            Int       @default(0)

  /// N-view self-destruct: delete when views >= maxViews
  maxViews         Int?

  /// Time capsule: server rejects GET requests before this timestamp
  timelockedUntil  DateTime?

  // ── Shamir secret sharing fields ──────────────────────────────────────────

  /// True when this row stores a single Shamir SSS shard
  shard            Boolean   @default(false)

  /// 1-based shard index (null for non-shard pastes)
  shardIndex       Int?

  /// Total number of shards in the scheme
  shardTotal       Int?

  // ── Asymmetric RSA-OAEP key wrapping fields ───────────────────────────────

  /// True when adata[4] carries an RSA-OAEP wrapped AES key
  recipientMode    Boolean   @default(false)

  /// Ephemeral X25519 public key (reserved for future ECDH upgrade, nullable)
  ephemeralPubKey  String?   @db.Text

  // ── Model Relations ──────────────────────────────────────────────────────

  comments         Comment[]
  accessLog        AccessLog[]
}

// ── 2. Comment Model (E2EE Discussion Threads) ─────────────────────────

model Comment {
  id         String   @id @default(cuid())
  pasteId    String
  /// Empty string = top-level comment
  parentId   String   @default("")
  /// AES-256-GCM encrypted comment body (same cipher as paste)
  ciphertext String   @db.Text
  adata      Json
  /// Optional emoji icon (≤ 8 chars)
  icon       String?
  createdAt  DateTime @default(now())

  paste      Paste    @relation(fields: [pasteId], references: [id], onDelete: Cascade)
}

// ── 3. AccessLog Model (Anonymized HMAC IP Access Audit Log) ─────────

model AccessLog {
  id         String   @id @default(cuid())
  pasteId    String
  /// HMAC-SHA256(raw_ip, server-side salt) — never stores raw IP
  ipHash     String
  accessedAt DateTime @default(now())

  paste      Paste    @relation(fields: [pasteId], references: [id], onDelete: Cascade)
}

// ── 4. ServerConfig Model (Key-Value Store for Server Secrets) ─────────

model ServerConfig {
  key   String @id
  value String
}
