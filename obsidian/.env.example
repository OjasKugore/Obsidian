# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env.local and fill in real values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Neon / Vercel Postgres ────────────────────────────────────────────────────
# Auto-injected when you add Vercel Postgres via the Vercel marketplace.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true&connect_timeout=15"

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Auto-injected when you add Upstash Redis via the Vercel marketplace.
UPSTASH_REDIS_REST_URL="https://YOUR-REDIS-INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"

# ── Pusher ────────────────────────────────────────────────────────────────────
# Get these from https://pusher.com → your app → Keys
PUSHER_APP_ID="YOUR_PUSHER_APP_ID"
PUSHER_KEY="YOUR_PUSHER_KEY"
PUSHER_SECRET="YOUR_PUSHER_SECRET"
PUSHER_CLUSTER="ap2"

# NEXT_PUBLIC_* vars are exposed to the browser bundle — safe to expose key+cluster
NEXT_PUBLIC_PUSHER_KEY="YOUR_PUSHER_KEY"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# ── Server-side secrets ───────────────────────────────────────────────────────
# 32-byte random hex string used for HMAC-ing IP addresses in AccessLog and receipts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HMAC_SECRET="GENERATE_A_RANDOM_64_HEX_CHAR_STRING_HERE"

# Optional secret to protect Vercel Cron invocation endpoints
CRON_SECRET="GENERATE_A_RANDOM_CRON_SECRET_HERE"

