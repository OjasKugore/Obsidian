# ─────────────────────────────────────────────────────────────────────────────
# .env.example — template for local environment variables
# Copy this file to .env.local: cp .env.example .env.local
# NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────────────────────────

# ── Neon / Vercel Postgres ────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Upstash Redis (Optional for local, required for production rate-limiting) ──
UPSTASH_REDIS_REST_URL="https://YOUR-REDIS-INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"

# ── Pusher (Real-Time E2EE Live Pad) ──────────────────────────────────────────
PUSHER_APP_ID="YOUR_PUSHER_APP_ID"
PUSHER_KEY="YOUR_PUSHER_KEY"
PUSHER_SECRET="YOUR_PUSHER_SECRET"
PUSHER_CLUSTER="ap2"

# NEXT_PUBLIC_* vars are exposed to the browser bundle — safe to expose key+cluster
NEXT_PUBLIC_PUSHER_KEY="YOUR_PUSHER_KEY"
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

# ── Server-side secrets ───────────────────────────────────────────────────────
# 32-byte random hex string used for HMAC-ing IP addresses in AccessLog and receipts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HMAC_SECRET="GENERATE_A_RANDOM_64_HEX_CHAR_STRING_HERE"

# Optional secret to protect Vercel Cron invocation endpoints
CRON_SECRET="GENERATE_A_RANDOM_CRON_SECRET_HERE"
